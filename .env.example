# Copy to .env and fill in. Compose reads this file automatically.
# .env is gitignored — keep real keys out of the repository.

# Free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# "imdb" (OMDb, default when a key is set), "tmdb", or "none" to switch lookups off
CINEVOTE_POSTER_SOURCE=

# Alternative backend, used when CINEVOTE_POSTER_SOURCE=tmdb
TMDB_API_KEY=

# The single admin. Leave the password empty to have one generated on first
# start and printed in the logs.
CINEVOTE_ADMIN_USERNAME=admin
CINEVOTE_ADMIN_PASSWORD=

# Shared invite code for sign-up. Empty means anyone who can reach the site
# can create an account.
CINEVOTE_REGISTRATION_CODE=

CINEVOTE_SITE_NAME=CineVote
CINEVOTE_MAX_VOTES=5
CINEVOTE_PORT=8080

# Set to true when serving over HTTPS (marks cookies Secure)
CINEVOTE_SECURE_COOKIES=false
